#### PARTICIPANT FILE (json) # ability of combining runs etc

data="/home/hayabusa/PROJECT_MPN/MPN_DERIVATIVES/MPN_MRIQC/sub-MPN0000106*/*/ses-MPN1Scan1/func/*_ses-MPN1Scan1_task-present*_bold.json"
file_list  = glob.glob(data)
variables = ['snr','tsnr', 'dvars_std','efc','fd_mean']
data_list = []

# 2. Loop through files with validation
for file in file_list:
    try:
        with open(file, 'r') as f:
            data = json.load(f)
            # Ensure data is not empty and is a dictionary/list
            if not data:
                print(f"Skipping empty file: {file}")
                continue
            # Need to remove problematic fields
            keys_to_remove = ["aor", "aqi","bids_meta","gcor","provenance"]
            for key in keys_to_remove:
                data.pop(key, None)
            # Assuming JSON structure: {"variable1": [...], "variable2": [...]}
            df_temp = pd.DataFrame([data]) # wrap dictionary into a list
            df_temp['source'] = file # Label data source
            data_list.append(df_temp)
            
    except (json.JSONDecodeError, OSError) as e:
        print(f"Skipping invalid/missing JSON file {file}: {e}")
        continue
     
df_all = pd.concat(data_list, ignore_index=True)
df_melted_SINGLE = df_all.melt(id_vars=['source'], value_vars=variables, 
                            var_name='IQM', value_name='Value')



# ############################# #
# Plot population violin plots

fig, axes = plt.subplots(len(variables), 1, figsize=(10, 5 * len(variables)))
sns.set(font_scale=1.5)
for i, var in enumerate(variables):

      # POP
      
      subset = df_melted[df_melted['IQM'] == var]
      sns.violinplot(data=subset, x='Value', y='IQM',fill=True, ax=axes[i], color="skyblue")
      sns.boxplot(data=subset, x='Value', y='IQM',fill=True, linewidth=1.5, linecolor="red", medianprops={"color": "r", "linewidth": 2},boxprops={"facecolor": "pink","linewidth": 1.5}, flierprops={"marker": "x", "markerfacecolor": "r", "linewidth": 2},  ax=axes[i])
      sns.stripplot(data=subset, x='Value', y='IQM',linewidth=1.5, color="red", edgecolor="r",  ax=axes[i])
      
      
       # Quantify OUtliers and print %
      # 2. Calculate IQR (Interquartile Range)
      q1 = subset["Value"].quantile(0.25)
      q3 = subset["Value"].quantile(0.75)
      iqr = q3 - q1

      # 3. Define outlier boundaries
      lower_bound = q1 - 1.5 * iqr
      upper_bound = q3 + 1.5 * iqr

      # 4. Identify outliers
      outliers = subset[(subset["Value"]< lower_bound) | (subset["Value"] > upper_bound)]

      # 5. Quantify the percentage
      total_points = len(subset["Value"])
      num_outliers = len(outliers)
      percentage_outliers = (num_outliers / total_points) * 100

      print(f"Total Data Points in {var}: {total_points}")
      print(f"Number of Outliers in {var}: {num_outliers}")
      print(f"Percentage of Outliers in {var}: {percentage_outliers:.2f}%")
      
      # Apply the flag per category group
      sns.stripplot(data=outliers, x='Value', y='IQM',linewidth=1.5, color="yellow", edgecolor="y",  ax=axes[i])

      
      # SINGLE
      subset2 = df_melted_SINGLE[df_melted_SINGLE['IQM'] == var]
      sns.stripplot(data=subset2, x='Value', y='IQM',linewidth=3.5, color="green", edgecolor="green",  ax=axes[i])
      axes[i].set_title(f'Distribution of {var}')
      axes[i].set_xticklabels(axes[i].get_xticklabels(),rotation=45,ha='right')
   

