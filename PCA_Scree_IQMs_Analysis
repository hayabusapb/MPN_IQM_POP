### POPULATION REFERENCE FILE

#data_tsv="/home/hayabusa/PROJECT_MPN/MPN_DERIVATIVES/MPN_MRIQC/group_bold_MPN.tsv"

data_tsv="/home/hayabusa/PROJECT_MPN/MPN_DERIVATIVES/MPN_MRIQC/MRIQC_MPN_LARGEPOPULATION_REPORTS/group_bold_ses-MPN1Scan1__task-rest.tsv"
df = pd.read_csv(data_tsv, sep='\\t', index_col=0)

# 2. Filter rows using wildcards (regex)
# '^Gene_.*' matches rows starting with 'Gene_'
filtered_df = df.filter(regex='^.*ses-MPN1Scan1_task-rest.*echo-1_bold', axis=0)
features = filtered_df.drop(columns=['bids_name','gcor','aqi','aor'], errors='ignore')


features = features.select_dtypes(include=[np.number]).dropna(axis=1)

# 3. Standardize the features (Crucial for PCA)
scaler = StandardScaler()
scaled_features = scaler.fit_transform(features)

# 4. Fit PCA
pca = PCA(n_components=4) # Inspect the top 5 principal components
principal_components = pca.fit_transform(scaled_features)
pca_df = pd.DataFrame(data=principal_components, columns=["PC1", "PC2","PC3", "PC4"])

# 5. Extract feature loadings to see which IQMs characterize each component
loadings = pd.DataFrame(
    pca.components_.T, 
    columns=[f'PC{i+1}' for i in range(4)], 
    index=features.columns
)



modality='BOLD'
# 6. Display top 5 metrics characterizing PC1, PC2, PC3
print(f"--- Top features for {modality} PC1 ---")
print(loadings['PC1'].abs().sort_values(ascending=False).head(4))

print(f"\n--- Top features for {modality} PC2 ---")
print(loadings['PC2'].abs().sort_values(ascending=False).head(4))

print(f"--- Top features for {modality} PC3 ---")
print(loadings['PC3'].abs().sort_values(ascending=False).head(4))

print(f"\n--- Top features for {modality} PC4 ---")
print(loadings['PC4'].abs().sort_values(ascending=False).head(4))

# 7. Print explained variance
print(f"\nExplained variance per component: {pca.explained_variance_ratio_}") # PC1-3 explain ~60% variance
# First 2 components explained variance
print(f"\nExplained variance for PC1 and PC2: {pca.explained_variance_ratio_[0]+pca.explained_variance_ratio_[1]}") 



# 5. Plot the first two principal components
plt.figure(figsize=(8, 6))
plt.scatter(pca_df["PC1"], pca_df["PC2"], alpha=0.7, linewidth=0.5)
# Add labels and variance explanation ratios
exp_var = pca.explained_variance_ratio_ * 100
plt.xlabel(f"Principal Component 1 ({exp_var[0]:.2f}% Variance)")
plt.ylabel(f"Principal Component 2 ({exp_var[1]:.2f}% Variance)")
plt.title("PCA of MRIQC Image Quality Metrics (IQMs)")
plt.grid(True, linestyle="--", alpha=0.5)
plt.show()

# 5. Plot the 3rd and 4th components
plt.figure(figsize=(8, 6))
plt.scatter(pca_df["PC3"], pca_df["PC4"], alpha=0.7, linewidth=0.5)
# Add labels and variance explanation ratios
exp_var = pca.explained_variance_ratio_ * 100
plt.xlabel(f"Principal Component 3 ({exp_var[2]:.2f}% Variance)")
plt.ylabel(f"Principal Component 4 ({exp_var[3]:.2f}% Variance)")
plt.title("PCA of MRIQC Image Quality Metrics (IQMs)")
plt.grid(True, linestyle="--", alpha=0.5)
plt.show()


# 5. Plot the scree plot
plt.figure(figsize=(8, 5))
plt.plot(
    range(1, len(exp_var) + 1),
    exp_var,
    "o-",
    linewidth=2,
    color="b",
)
plt.title("Scree Plot of MRIqc IQMs")
plt.xlabel("Principal Component")
plt.ylabel("Explained Variance (%)")
plt.grid(True)
plt.show()


